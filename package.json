{
  "name": "creativetugs-qualifier",
  "private": true,
  "type": "module",
  "description": "Creative Tugs sales lead qualifier — playground + HTTP",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "start": "sh -c 'npx --yes @grok/agent-sdk@0.5.0 serve --dir . --mode single --host 0.0.0.0 --port ${PORT:-3000}'",
    "prestart": "node -e \"const [maj,min]=process.versions.node.split('.').map(Number); if(maj<22||(maj===22&&min<13)){console.error('Agent SDK needs Node >= 22.13 (got '+process.versions.node+').'); process.exit(1)}\""
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
